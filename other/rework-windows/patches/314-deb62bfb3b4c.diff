 #include "base/threading/scoped_thread_priority.h"
 #include "base/time/time.h"
 
 namespace metrics {
 
 namespace {
+
+// Some downlevel systems do not have the Windows Event Log API. Resolve the
+// complete set before acquiring handles so every acquired handle can be closed.
+struct EventLogApi {
+  decltype(&::EvtQuery) query;
+  decltype(&::EvtNext) next;
+  decltype(&::EvtRender) render;
+  decltype(&::EvtCreateRenderContext) create_render_context;
+  decltype(&::EvtClose) close;
+};
+
+const EventLogApi& GetEventLogApi() {
+  static const EventLogApi api = [] {
+    EventLogApi result = {};
+    HMODULE module = base::PinSystemLibrary(L"wevtapi.dll");
+    if (module) {
+      result.query = reinterpret_cast<decltype(result.query)>(
+          ::GetProcAddress(module, "EvtQuery"));
+      result.next = reinterpret_cast<decltype(result.next)>(
+          ::GetProcAddress(module, "EvtNext"));
+      result.render = reinterpret_cast<decltype(result.render)>(
+          ::GetProcAddress(module, "EvtRender"));
+      result.create_render_context =
+          reinterpret_cast<decltype(result.create_render_context)>(
+              ::GetProcAddress(module, "EvtCreateRenderContext"));
+      result.close = reinterpret_cast<decltype(result.close)>(
+          ::GetProcAddress(module, "EvtClose"));
+    }
+    return result;
+  }();
+  return api;
+}
 
 // The name of the log channel to query.
 const wchar_t kChannelName[] = L"System";

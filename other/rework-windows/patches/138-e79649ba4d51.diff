 namespace {
 
 // See: https://learn.microsoft.com/en-us/windows/win32/seccng/processprng
 typedef BOOL(WINAPI *ProcessPrngFunction)(PBYTE pbData, SIZE_T cbData);
 ProcessPrngFunction g_processprng_fn = nullptr;
 
+BOOL WINAPI legacy_processprng(PBYTE output, SIZE_T length) {
+  while (length > 0) {
+    ULONG chunk = ULONG_MAX;
+    if (length < chunk) {
+      chunk = static_cast<ULONG>(length);
+    }
+    if (!::SystemFunction036(output, chunk)) {
+      return FALSE;
+    }
+    output += chunk;
+    length -= chunk;
+  }
+  return TRUE;
+}
+

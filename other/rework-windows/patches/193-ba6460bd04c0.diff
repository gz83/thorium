 #include <string_view>
 
 #include "base/containers/span.h"
@@ -563,4 +565,42 @@
   // Clean up done by NtRegistryTest.
 }
 
+TEST_F(NtRegistryTest, ApiEnumeration) {
+  constexpr wchar_t root[] = L"NTRegistry\\enum";
+  HANDLE parent;
+  ASSERT_TRUE(nt::CreateRegKey(nt::HKCU, root, KEY_READ, &parent));
+  absl::Cleanup close_parent = [parent] { nt::CloseRegKey(parent); };
+  ULONG count = 0;
+  ASSERT_TRUE(nt::QueryRegEnumerationInfo(parent, &count));
+  EXPECT_EQ(count, 0u);
+
+  const std::set<std::wstring> names = {
+      L"one", L"two", L"long-subkey-\u6d4b\u8bd5-0123456789"};
+  for (const auto& name : names) {
+    std::wstring path = std::wstring(root) + L"\\" + name;
+    HANDLE child;
+    ASSERT_TRUE(nt::CreateRegKey(nt::HKCU, path.c_str(), KEY_WRITE, &child));
+    absl::Cleanup close_child = [child] { nt::CloseRegKey(child); };
+    ASSERT_TRUE(nt::SetRegValueDWORD(child, L"", 1234));
+  }
+
+  ASSERT_TRUE(nt::QueryRegEnumerationInfo(parent, &count));
+  ASSERT_EQ(count, names.size());
+  std::set<std::wstring> found;
+  for (ULONG i = 0; i < count; ++i) {
+    std::wstring name;
+    ASSERT_TRUE(nt::QueryRegSubkey(parent, i, &name));
+    found.insert(name);
+    const std::wstring path = std::wstring(root) + L"\\" + name;
+    DWORD value = 0;
+    EXPECT_TRUE(nt::QueryRegValueDWORD(nt::HKCU, nt::NONE, path.c_str(),
+                                       L"", &value));
+    EXPECT_EQ(value, 1234u);
+  }
+  EXPECT_EQ(found, names);
+  std::wstring name = L"unchanged";
+  EXPECT_FALSE(nt::QueryRegSubkey(parent, count, &name));
+  EXPECT_EQ(name, L"unchanged");
+}

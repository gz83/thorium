+struct RestartManager {
+  base::ScopedNativeLibrary library{base::LoadSystemLibrary(L"rstrtmgr.dll")};
+  decltype(&::RmStartSession) start = reinterpret_cast<decltype(start)>(
+      library.GetFunctionPointer("RmStartSession"));
+  decltype(&::RmRegisterResources) register_resources =
+      reinterpret_cast<decltype(register_resources)>(
+          library.GetFunctionPointer("RmRegisterResources"));
+  decltype(&::RmShutdown) shutdown = reinterpret_cast<decltype(shutdown)>(
+      library.GetFunctionPointer("RmShutdown"));
+  decltype(&::RmEndSession) end = reinterpret_cast<decltype(end)>(
+      library.GetFunctionPointer("RmEndSession"));
+
+  bool available() const {
+    return start && register_resources && shutdown && end;
+  }
+};
+
+std::optional<bool> MatchesInstalledImage(const base::FilePath& target,
+                                          const base::FilePath& image) {
+  if (image.empty()) {
+    return std::nullopt;
+  }
+  if (base::FilePath::CompareEqualIgnoreCase(target.value(), image.value())) {
+    return true;
+  }
+  if (base::ProcessImageQueryAccess() == PROCESS_QUERY_LIMITED_INFORMATION) {
+    return false;
+  }
+
+  // XP's device-path conversion can choose a different drive alias. Compare
+  // file identities before dismissing a running browser with a different path.
+  constexpr auto flags =
+      base::File::FLAG_OPEN | base::File::FLAG_WIN_SHARE_DELETE;
+  base::File target_file(target, flags);
+  if (!target_file.IsValid()) {
+    if (target_file.error_details() == base::File::FILE_ERROR_NOT_FOUND) {
+      return false;
+    }
+    return std::nullopt;
+  }
+  base::File image_file(image, flags);
+  BY_HANDLE_FILE_INFORMATION target_info, image_info;
+  if (!image_file.IsValid() ||
+      !::GetFileInformationByHandle(target_file.GetPlatformFile(), &target_info) ||
+      !::GetFileInformationByHandle(image_file.GetPlatformFile(), &image_info)) {
+    return std::nullopt;
+  }
+  return target_info.dwVolumeSerialNumber == image_info.dwVolumeSerialNumber &&
+         target_info.nFileIndexHigh == image_info.nFileIndexHigh &&
+         target_info.nFileIndexLow == image_info.nFileIndexLow;
+}
 

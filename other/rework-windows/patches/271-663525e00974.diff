+std::vector<LanguageTag> GetDefaultUILanguageList() {
+  const LANGID id = ::GetUserDefaultUILanguage();
+  if (id == LOCALE_CUSTOM_UI_DEFAULT) {
+    return {};
+  }
+  const LCID locale = MAKELCID(id, SORT_DEFAULT);
+  const auto locale_part = [locale](LCTYPE type) {
+    wchar_t buffer[9] = {};
+    const int length = ::GetLocaleInfoW(locale, type, buffer, std::size(buffer));
+    return length > 1 ? std::wstring(buffer, length - 1) : std::wstring();
+  };
+  const auto language = locale_part(LOCALE_SISO639LANGNAME);
+  std::vector<LanguageTag> tags;
+  if (!language.empty() && SUBLANGID(id) != SUBLANG_NEUTRAL) {
+    const auto region = locale_part(LOCALE_SISO3166CTRYNAME);
+    if (!region.empty()) {
+      if (auto tag = GetLanguageTagFromString(WideToASCII(language + L"-" + region))) {
+        tags.push_back(*tag);
+      }
+    }
+  }
+  if (auto tag = GetLanguageTagFromString(WideToASCII(language))) {
+    tags.push_back(*tag);
+  }
+  return tags;
+}
+
+GetPreferredUILanguages_Fn ResolveLanguageFunction(const char* name) {
+  return reinterpret_cast<GetPreferredUILanguages_Fn>(
+      ::GetProcAddress(::GetModuleHandleW(L"kernel32.dll"), name));
+}

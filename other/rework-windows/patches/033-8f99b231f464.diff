-  TBS_RESULT tbs_result = ::Tbsip_Submit_Command(
+  // Using dynamic loading instead of using linker support for delay
+  // loading to prevent failed loads being treated as a fatal failure which
+  // can happen in rare cases due to missing or corrupted DLL file.
+  base::ScopedNativeLibrary tbs_library(base::LoadSystemLibrary(L"tbs.dll"));
+  if (!tbs_library.is_valid()) {
+    return std::nullopt;
+  }
+
+  decltype(Tbsip_Submit_Command)* tbsip_submit_command_proc =
+      reinterpret_cast<decltype(Tbsip_Submit_Command)*>(

 namespace {
 
+// Some sections in a mapped PE can be inaccessible even in a valid image.
+bool TouchImagePages(span<const volatile uint8_t> bytes, size_t stride) {
+  __try {
+    while (!bytes.empty()) {
+      static_cast<void>(bytes.front());
+      if (bytes.size() <= stride) {
+        static_cast<void>(bytes.back());
+        break;
+      }
+      bytes = bytes.subspan(stride);
+    }
+    return true;
+  } __except (EXCEPTION_EXECUTE_HANDLER) {
+    return false;
+  }
+}
+
+bool PreReadLegacyImage(const FilePath& path, int64_t max_bytes) {
+  ScopedNativeLibrary module(::LoadLibraryExW(path.value().c_str(), nullptr,
+                                              DONT_RESOLVE_DLL_REFERENCES));
+  if (!module.is_valid())
+    return false;
+  win::PEImage image(module.get());
+  if (!image.VerifyMagic())
+    return false;
+  const size_t size = checked_cast<size_t>(std::min<int64_t>(
+      image.GetNTHeaders()->OptionalHeader.SizeOfImage, max_bytes));
+  SYSTEM_INFO info = {};
+  ::GetSystemInfo(&info);
+  // SAFETY: the loader mapped SizeOfImage bytes and the module owns this
+  // mapping throughout the read. TouchImagePages handles inaccessible pages.
+  return TouchImagePages(UNSAFE_BUFFERS(span(
+      reinterpret_cast<const volatile uint8_t*>(module.get()), size)),
+      info.dwPageSize ? info.dwPageSize : 4096u);
+}

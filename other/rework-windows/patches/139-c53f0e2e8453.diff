 namespace partition_alloc::internal::base {
+
+namespace {
+
+BOOL WINAPI LegacyProcessPrng(BYTE* output, SIZE_T length) {
+  while (length) {
+    const auto chunk = static_cast<ULONG>(
+        std::min<size_t>(length, std::numeric_limits<ULONG>::max()));
+    if (!::SystemFunction036(output, chunk)) {
+      return FALSE;
+    }
+    length -= chunk;
+    // SAFETY: chunk is bounded by the remaining caller-provided buffer.
+    PA_UNSAFE_BUFFERS(output += chunk);
+  }
+  return TRUE;
+}

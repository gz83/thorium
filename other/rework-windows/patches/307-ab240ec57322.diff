+ShellUtil::DefaultState ProbeOpenCommandHandlers(
+    const base::FilePath& chrome_exe,
+    base::span<const base::wcstring_view> identifiers,
+    ASSOCIATIONTYPE type) {
+  const HKEY root_key = HKEY_CLASSES_ROOT;

+  std::wstring normalized(name);
+  for (wchar_t& c : normalized) {
+    if (c == L'_') {
+      c = L'-';
+    } else if (c >= L'A' && c <= L'Z') {
+      c += L'a' - L'A';
+    }
+  }
+  std::wstring_view tag(normalized);
+  while (!tag.empty()) {
+    for (const auto& locale : locales) {
+      if (locale.tag == tag) {
+        if (!(flags & LOCALE_ALLOW_NEUTRAL_NAMES) &&
+            SUBLANGID(LANGIDFROMLCID(locale.id)) == SUBLANG_NEUTRAL) {
+          // Numeric formatting calls on XP need a specific locale.
+          return locale.id == LANG_CHINESE ? 0x0804
+                                          : MAKELCID(MAKELANGID(locale.id, SUBLANG_DEFAULT),
+                                                     SORT_DEFAULT);
+        }
+        return locale.id;
+      }
+    }
+    const auto separator = tag.rfind(L'-');

+
+inline std::wstring GetLegacyUILanguageName(LANGID id) {
+  const LCID locale = MAKELCID(id, SORT_DEFAULT);
+  wchar_t name[LOCALE_NAME_MAX_LENGTH] = {};
+  if (::GetLocaleInfoW(locale, LOCALE_SNAME, name, std::size(name)) > 1) {
+    return name;
+  }
+
+  wchar_t language[9] = {};
+  if (::GetLocaleInfoW(locale, LOCALE_SISO639LANGNAME, language,
+                       std::size(language)) <= 1) {
+    return {};
+  }
+  std::wstring tag(language);
+  // ISO language and country alone cannot distinguish these XP UI locales.
+  switch (id) {
+    case 0x141a:  // bs-Latn-BA
+    case 0x042c:  // az-Latn
+    case 0x0443:  // uz-Latn
+    case 0x081a:  // sr-Latn-CS
+    case 0x181a:  // sr-Latn-BA
+      tag += L"-Latn";
+      break;
+    case 0x201a:  // bs-Cyrl-BA
+    case 0x082c:  // az-Cyrl
+    case 0x0843:  // uz-Cyrl
+    case 0x0c1a:  // sr-Cyrl-CS
+    case 0x1c1a:  // sr-Cyrl-BA
+      tag += L"-Cyrl";
+      break;
+  }
+  wchar_t region[9] = {};
+  if (SUBLANGID(id) != SUBLANG_NEUTRAL &&
+      ::GetLocaleInfoW(locale, LOCALE_SISO3166CTRYNAME, region,
+                       std::size(region)) > 1) {
+    tag += L'-';
+    tag += region;
+  }
+  return tag;
+}

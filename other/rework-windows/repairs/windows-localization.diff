+// The XP Control Panel obtains this item's localized title from its applet.
+std::u16string GetXpUninstallAppletName() {
+  base::ScopedNativeLibrary module(base::LoadSystemLibrary(L"appwiz.cpl"));
+  const auto applet =
+      reinterpret_cast<APPLET_PROC>(module.GetFunctionPointer("CPlApplet"));
+  if (!applet || !applet(nullptr, CPL_INIT, 0, 0)) {
+    return {};
+  }
+
+  std::u16string name;
+  if (applet(nullptr, CPL_GETCOUNT, 0, 0) > 0) {
+    CPLINFO info = {};
+    applet(nullptr, CPL_INQUIRE, 0, reinterpret_cast<LPARAM>(&info));
+    if (info.idName > 0) {
+      wchar_t* resource = nullptr;
+      const int length = ::LoadStringW(module.get(), info.idName,
+                                       reinterpret_cast<LPWSTR>(&resource), 0);
+      if (length > 0) {
+        name = base::WideToUTF16(std::wstring_view(resource, length));
+      }
+    } else if (info.idName == CPL_DYNAMIC_RES) {
+      NEWCPLINFOW details = {};
+      details.dwSize = sizeof(details);
+      applet(nullptr, CPL_NEWINQUIRE, 0, reinterpret_cast<LPARAM>(&details));
+      if (details.dwSize == sizeof(details) && details.szName[0]) {
+        name = base::WideToUTF16(std::wstring_view(details.szName));
+        info.lData = details.lData;
+      }
+      if (details.hIcon) {
+        ::DestroyIcon(details.hIcon);
+      }
+    }
+    applet(nullptr, CPL_STOP, 0, info.lData);
+  }
+  applet(nullptr, CPL_EXIT, 0, 0);
+  return name;
+}
+
+std::u16string GetUninstallAppletName(base::win::Version version) {
+  std::u16string name;
+  if (version < base::win::Version::VISTA) {
+    name = GetXpUninstallAppletName();
+  } else {
+    // Shell display resource for Microsoft.ProgramsAndFeatures.
+    wchar_t title[MAX_PATH] = {};
+    if (SUCCEEDED(::SHLoadIndirectString(
+            L"@%SystemRoot%\\system32\\appwiz.cpl,-159", title,
+            std::size(title), nullptr))) {
+      name = base::WideToUTF16(std::wstring_view(title));
+    }
+  }
+  return name.empty() ? u"appwiz.cpl" : name;
+}

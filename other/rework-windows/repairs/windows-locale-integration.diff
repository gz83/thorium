+
+std::optional<CpuSample>
+CpuProbeWin::BlockingTaskRunnerHelper::UpdateFromSystemTimes() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  static const auto get_times = reinterpret_cast<decltype(&::GetSystemTimes)>(
+      ::GetProcAddress(::GetModuleHandleW(L"kernel32.dll"), "GetSystemTimes"));
+  FILETIME idle, kernel, user;
+  if (!get_times || !get_times(&idle, &kernel, &user)) {
+    return std::nullopt;
+  }
+  // Windows includes idle time in the kernel total.
+  SystemTimes now{Ticks(idle), Ticks(kernel) + Ticks(user)};
+  auto previous = std::exchange(previous_times_, now);
+  if (!previous || now.total <= previous->total || now.idle < previous->idle) {
+    return std::nullopt;
+  }
+  const uint64_t elapsed = now.total - previous->total;
+  const uint64_t idle_ticks = now.idle - previous->idle;
+  if (idle_ticks > elapsed) {
+    return std::nullopt;
+  }
+  return CpuSample{static_cast<double>(elapsed - idle_ticks) / elapsed};
 }
 

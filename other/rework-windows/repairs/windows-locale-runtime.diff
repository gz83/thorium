+static void appendWindowsFormat(decltype(&GetTimeFormatW) format, LCID locale, DWORD flags,
+                                const SYSTEMTIME *st, UnicodeString &appendTo)
+{
+    MaybeStackArray<wchar_t, STACK_BUFFER_SIZE> buffer;
+    int length = format(locale, flags, st, nullptr, buffer.getAlias(), buffer.getCapacity());
+    if (length == 0 && GetLastError() == ERROR_INSUFFICIENT_BUFFER) {
+        const int required = format(locale, flags, st, nullptr, nullptr, 0);
+        if (required <= 0 || !buffer.resize(required, 0)) {
+            return;
+        }
+        length = format(locale, flags, st, nullptr, buffer.getAlias(), required);
+    }
+    if (length > 0) {
+        appendTo.append(reinterpret_cast<const char16_t *>(buffer.getAlias()), length - 1);
+    }
+}

+// XP supplies one UI LANGID instead of a preferred-language list.
+inline std::vector<std::wstring> GetLegacyUILanguageCandidates(LANGID id) {
+  std::vector<std::wstring> candidates;
+  std::wstring name = GetLegacyUILanguageName(id);
+  while (!name.empty()) {
+    // Keep Latin American Spanish ahead of the generic Spanish resource.
+    if (name == L"es" && PRIMARYLANGID(id) == LANG_SPANISH &&
+        SUBLANGID(id) != SUBLANG_NEUTRAL && SUBLANGID(id) != SUBLANG_SPANISH &&
+        SUBLANGID(id) != SUBLANG_SPANISH_MODERN &&
+        (candidates.empty() || candidates.back() != L"es-419")) {
+      candidates.emplace_back(L"es-419");
+    }
+    candidates.push_back(name);
+    const auto separator = name.rfind(L'-');
+    if (separator == std::wstring::npos) {
+      if (name == L"nn") {
+        candidates.emplace_back(L"no");
+      }
+      break;
+    }
+    name.resize(separator);
+  }
+  return candidates;
+}
+
 }  // namespace base::win
 

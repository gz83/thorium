+ui::mojom::WindowOpenDisposition MaybeOverrideOmniboxCurrentTabDisposition(
+    ui::mojom::WindowOpenDisposition disposition) {
+  if (disposition != ui::mojom::WindowOpenDisposition::kCurrentTab ||
+      !base::FeatureList::IsEnabled(features::kOpenOmniboxUrlInNewTab)) {
+    return disposition;
+  }
+
+  const std::string mode = features::kOpenOmniboxUrlInNewTabMode.Get();
+  if (mode == "background") {
+    return ui::mojom::WindowOpenDisposition::kNewBackgroundTab;
+  }
+
+  // Default to foreground for unknown values as well as the default parameter.
+  return ui::mojom::WindowOpenDisposition::kNewForegroundTab;
+}

+bool OffStoreInstallAllowedByUser(Profile* profile, const DownloadItem& item) {
+  const auto* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch("allow-offstore-extension-downloads") ||
+      command_line->HasSwitch(extensions::switches::kDisableExtensions) ||
+      profile->IsOffTheRecord() || profile->IsChild() ||
+      !profile->GetPrefs()->GetBoolean(prefs::kExtensionsUIDeveloperMode) ||
+      (item.GetMimeType() != extensions::Extension::kMimeType &&
+       !item.GetFileNameToReportUser().MatchesExtension(
+           FILE_PATH_LITERAL(".crx")))) {
+    return false;
+  }
+#if BUILDFLAG(IS_ANDROID)
+  if (!base::FeatureList::IsEnabled(
+          extensions_features::kEnableExtensionsAndroid)) {
+    return false;
+  }
+#endif
+  // Keep the Web Store's additional proof requirement, including approved
+  // installs and downloads redirected from a Web Store URL.
+  return !WebstoreInstaller::GetAssociatedApproval(item) &&
+         !extension_urls::IsWebstoreDomain(item.GetOriginalUrl()) &&
+         !extension_urls::IsWebstoreUpdateUrl(item.GetOriginalUrl()) &&
+         !extension_urls::IsWebstoreDomain(item.GetURL()) &&
+         !extension_urls::IsWebstoreUpdateUrl(item.GetURL());
+}

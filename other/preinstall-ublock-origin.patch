diff --git a/chrome/browser/extensions/preinstalled_extensions.cc b/chrome/browser/extensions/preinstalled_extensions.cc
index 0d681e3a260a1..ea6f84d8c2ff3 100644
--- a/chrome/browser/extensions/preinstalled_extensions.cc
+++ b/chrome/browser/extensions/preinstalled_extensions.cc
@@ -38,6 +38,9 @@ static_assert(BUILDFLAG(ENABLE_EXTENSIONS_CORE));
 
 namespace {
 
+constexpr char kUBlockOriginExtensionId[] =
+    "cjpalhdlnbpafiamejdnhcphjbkeiagm";
+
 using extensions::mojom::ManifestLocation;
 
 #if BUILDFLAG(ENABLE_PLATFORM_APPS)
@@ -105,16 +108,16 @@ bool Provider::DidPerformNewInstallationForProfile(Profile* profile) {
 void Provider::InitProfileState() {
   // We decide to install or not install pre-installed extensions based on the
   // following criteria, from highest priority to lowest priority:
-  //
-  // - If the locale is not compatible with the pre-installed extensions, don't
-  //   install them.
   // - The kPreinstalledExtensions preferences value in the profile.  This
   //   value is usually set in the master_preferences file.
   // - If they have already been installed, don't reinstall them.
+  //
+  // Locale compatibility is applied to Chromium's pre-installed extensions in
+  // SetPrefs(). Thorium's uBlock Origin pre-install supports every locale.
 
   preinstalled_extensions_enabled_ =
-      IsLocaleSupported() && profile_->GetPrefs()->GetString(
-                                 prefs::kPreinstalledExtensions) == "install";
+      profile_->GetPrefs()->GetString(prefs::kPreinstalledExtensions) ==
+      "install";
   DCHECK(!perform_new_installation_);
 
   InstallState state =
@@ -199,12 +202,19 @@ void Provider::VisitRegisteredExtension() {
 void Provider::SetPrefs(base::DictValue prefs) {
   DCHECK(preinstalled_extensions_enabled_);
 
+  // Chromium's pre-installed extensions are not available in every locale.
+  // Apply that restriction only to Chromium's entries; Thorium's uBlock
+  // Origin entry is added separately below and remains available everywhere.
+  if (!IsLocaleSupported()) {
+    prefs.clear();
+  }
+
   // Load a hard-coded list of external extensions. These are not component
   // extensions; they are installed from the webstore and don't get access to
   // component only APIs. Must be used with ManifestLocation::kInternal to allow
   // CWS to download certain extensions.
 #if BUILDFLAG(GOOGLE_CHROME_BRANDING)
-  if (perform_new_installation_) {
+  if (perform_new_installation_ && IsLocaleSupported()) {
     AddExtension(extension_misc::kDocsOfflineExtensionId, prefs);
   }
 #endif  // BUILDFLAG(GOOGLE_CHROME_BRANDING)
@@ -274,6 +284,12 @@ void Provider::SetPrefs(base::DictValue prefs) {
   }
 #endif  // BUILDFLAG(ENABLE_PLATFORM_APPS)
 
+  // Install uBlock Origin only with a newly created profile. The external
+  // provider retains Chromium's normal user-uninstall acknowledgement.
+  if (perform_new_installation_) {
+    AddExtension(kUBlockOriginExtensionId, prefs);
+  }
+
   ExternalProviderImpl::SetPrefs(std::move(prefs));
 }
 

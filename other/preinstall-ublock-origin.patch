diff --git a/chrome/browser/resources/ublock_origin/download.py b/chrome/browser/resources/ublock_origin/download.py
new file mode 100644
index 0000000000000..89fe73de3481f
--- /dev/null
+++ b/chrome/browser/resources/ublock_origin/download.py
@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+# Copyright 2026 The Thorium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+"""Fetch the pinned upstream uBO CRX for embedding in resources.pak."""
+
+import hashlib
+import os
+from pathlib import Path
+import sys
+import tempfile
+import urllib.request
+
+URL = (
+    "https://github.com/gorhill/uBlock/releases/download/1.74.0/"
+    "uBlock0_1.74.0.chromium.crx"
+)
+SHA256 = "b6be71ed3e3e85eaad8f02710b9071d06428e141d942c43d5f65d4526e82dc3e"
+
+
+def fetch(output):
+    if output.is_file() and hashlib.sha256(output.read_bytes()).hexdigest() == SHA256:
+        return
+    with urllib.request.urlopen(URL, timeout=60) as response:
+        data = response.read()
+    if hashlib.sha256(data).hexdigest() != SHA256:
+        raise ValueError("uBlock Origin CRX SHA-256 mismatch")
+    output.parent.mkdir(parents=True, exist_ok=True)
+    temporary = None
+    try:
+        with tempfile.NamedTemporaryFile(dir=output.parent, delete=False) as stream:
+            temporary = Path(stream.name)
+            stream.write(data)
+        os.replace(temporary, output)
+    finally:
+        if temporary is not None:
+            temporary.unlink(missing_ok=True)
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2:
+        sys.exit("usage: download.py OUTPUT_CRX")
+    try:
+        fetch(Path(sys.argv[1]))
+    except (OSError, ValueError) as error:
+        sys.exit(f"Cannot bundle uBlock Origin: {error}")

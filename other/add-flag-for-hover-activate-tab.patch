   CHECK(collection_node_);
 
+  hover_activate_timer_.Stop();
+
   // Hover state is handled by the parent if it is split.
   if (split_) {
     return;
@@ -734,6 +744,20 @@ void TabView::OnMouseExited(const ui::MouseEvent& event) {

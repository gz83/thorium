+void RenderViewContextMenu::AppendOtherSearchEngines() {
+  if (other_search_engines_submenu_ ||
+      !params_.properties.contains(
+          prefs::kDefaultSearchProviderContextMenuAccessAllowed)) {
+    return;
+  }
+  auto* service = TemplateURLServiceFactory::GetForProfile(GetProfile());
+  if (!service || !service->loaded()) {
+    return;
+  }
+
+  auto engines = service->GetTemplateURLs();
+  // Most automatically discovered site searches are inactive. Do not run
+  // locale-aware sorting or URL substitution on those entries.
+  std::erase_if(engines, [service](const TemplateURL* engine) {
+    return !IsOtherSearchEngine(engine, *service);
+  });
+  if (engines.empty()) {
+    return;
+  }
+  // Keep the settings page's main engines first, then active site searches.
+  const auto sites_begin = std::stable_partition(
+      engines.begin(), engines.end(), [service](const TemplateURL* engine) {
+        return service->ShowInDefaultList(engine);
+      });
+  if (engines.end() - sites_begin > 1) {
+    const internal::OrderTemplateUrlsByManagedAndAlphabetically compare;
+    // Copying this comparator clones its ICU collator. Reuse one instance
+    // throughout sorting, including when ICU initialization fails.
+    std::sort(sites_begin, engines.end(), std::cref(compare));
+  }
+#if BUILDFLAG(IS_CHROMEOS)
+  const TemplateURLRef::SearchTermsArgs menu_search_terms(
+      params_.selection_text);
+#else
+  // Validate the template using a short probe. Encoding a potentially large
+  // selection for every engine would delay opening the menu on the UI thread.
+  const TemplateURLRef::SearchTermsArgs menu_search_terms(u"x");
+#endif
+  for (const TemplateURL* engine : engines) {
+    const int command_id = IDC_CONTENT_CONTEXT_SEARCH_ENGINE_FIRST +
+                           static_cast<int>(other_search_engines_.size());
+    if (command_id > IDC_CONTENT_CONTEXT_SEARCH_ENGINE_LAST) {
+      break;
+    }
+    GURL url(engine->url_ref().ReplaceSearchTerms(
+        menu_search_terms, service->search_terms_data()));
+    if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+      continue;
+    }
+    if (!other_search_engines_submenu_) {
+      other_search_engines_submenu_ =
+          std::make_unique<ui::SimpleMenuModel>(this);
+      other_search_engines_.reserve(std::min(
+          engines.size(),
+          static_cast<size_t>(IDC_CONTENT_CONTEXT_SEARCH_ENGINE_LAST -
+                              IDC_CONTENT_CONTEXT_SEARCH_ENGINE_FIRST + 1)));
+    }
+    std::u16string name = engine->short_name();
+    EscapeAmpersands(&name);
+    other_search_engines_submenu_->AddItem(command_id, name);
+    OtherSearchEngine entry;
+    entry.id = engine->id();
+    entry.keyword = engine->keyword();
+    entry.short_name = engine->short_name();
+    entry.url = engine->url();
+    entry.post_params = engine->search_url_post_params();
+    entry.input_encodings = engine->input_encodings();
+#if BUILDFLAG(IS_CHROMEOS)
+    entry.search_url = std::move(url);
+#endif
+    other_search_engines_.push_back(std::move(entry));
+  }
+
+  if (other_search_engines_.size() > 1) {
+    // Names need not be unique in settings. Count only displayed entries, and
+    // disambiguate duplicates using their keywords before exposing the menu.
+    // The snapshots are now complete, so these string views remain valid.
+    std::unordered_map<std::u16string_view, size_t> name_counts;
+    name_counts.reserve(other_search_engines_.size());
+    for (const auto& entry : other_search_engines_) {
+      ++name_counts[entry.short_name];
+    }
+    for (size_t index = 0; index < other_search_engines_.size(); ++index) {
+      const auto& entry = other_search_engines_[index];
+      if (name_counts.at(entry.short_name) > 1) {
+        std::u16string name =
+            base::StrCat({entry.short_name, u" (", entry.keyword, u")"});
+        EscapeAmpersands(&name);
+        other_search_engines_submenu_->SetLabel(index, name);
+      }
+    }
+  }
+
+  if (other_search_engines_submenu_) {
+    other_search_engines_valid_ = true;
+    search_engine_observation_.Observe(service);
+    menu_model_.AddSubMenuWithStringId(IDC_CONTENT_CONTEXT_SEARCH_WITH,
+                                       IDS_CONTENT_CONTEXT_SEARCH_WITH,
+                                       other_search_engines_submenu_.get());
+  }
+}
+
+void RenderViewContextMenu::OnTemplateURLServiceChanged() {
+  // Notifications also include visits and automatically discovered engines.
+  // Those must not disable an otherwise unchanged, open submenu. Revalidate
+  // the saved entries without sorting or encoding the selection again.
+  for (size_t index = 0; index < other_search_engines_.size(); ++index) {
+    if (!GetOtherSearchEngine(IDC_CONTENT_CONTEXT_SEARCH_ENGINE_FIRST +
+                              static_cast<int>(index))) {
+      other_search_engines_[index].enabled = false;
+    }
+  }
+}
+
+void RenderViewContextMenu::OnTemplateURLServiceShuttingDown() {
+  other_search_engines_valid_ = false;
+  search_engine_observation_.Reset();
+}
+
+const TemplateURL* RenderViewContextMenu::GetOtherSearchEngine(
+    int command_id) const {
+  if (!IsOtherSearchEngineCommand(command_id) || !other_search_engines_valid_) {
+    return nullptr;
+  }
+  const size_t index = command_id - IDC_CONTENT_CONTEXT_SEARCH_ENGINE_FIRST;
+  if (index >= other_search_engines_.size()) {
+    return nullptr;
+  }
+  auto* service = search_engine_observation_.GetSource();
+  if (!service || !service->loaded()) {
+    return nullptr;
+  }
+  const auto& entry = other_search_engines_[index];
+  if (!entry.enabled) {
+    return nullptr;
+  }
+  // Legacy configurations can have duplicate sync GUIDs. The local ID remains
+  // stable while this service is alive, including across visit-time updates.
+  const TemplateURL* engine = service->GetTemplateURLForId(entry.id);
+  if (!IsOtherSearchEngine(engine, *service) ||
+      engine->keyword() != entry.keyword ||
+      engine->short_name() != entry.short_name || engine->url() != entry.url ||
+      engine->search_url_post_params() != entry.post_params ||
+      engine->input_encodings() != entry.input_encodings) {
+    return nullptr;
+  }
+  return engine;
+}
+
+std::optional<content::OpenURLParams>
+RenderViewContextMenu::GetOtherSearchEngineParams(int command_id,
+                                                  int event_flags) {
+  const TemplateURL* engine = GetOtherSearchEngine(command_id);
+  if (!engine || !IsCommandIdEnabled(command_id)) {
+    return std::nullopt;
+  }
+  auto* service = TemplateURLServiceFactory::GetForProfile(GetProfile());
+  TemplateURLRef::PostContent post_content;
+  const GURL url(engine->url_ref().ReplaceSearchTerms(
+      TemplateURLRef::SearchTermsArgs(params_.selection_text),
+      service->search_terms_data(), &post_content));
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() ||
+      !IsOpenLinkAllowedByDlp(url)) {
+    return std::nullopt;
+  }
+  const bool is_post = !post_content.first.empty();
+  auto open_params = GetOpenURLParamsWithExtraHeaders(
+      url, /*referring_url=*/GURL(), /*initiator=*/{},
+      ui::DispositionFromEventFlags(event_flags,
+                                    ui::mojom::WindowOpenDisposition::kNewForegroundTab),
+      ui::PAGE_TRANSITION_LINK,
+      is_post ? base::StrCat({"Content-Type: ", post_content.first, "\r\n"})
+              : std::string(),
+      /*started_from_context_menu=*/true);
+  if (is_post) {
+    open_params.post_data = network::ResourceRequestBody::CreateFromCopyOfBytes(
+        base::as_byte_span(post_content.second));
+  }
+  return open_params;
+}

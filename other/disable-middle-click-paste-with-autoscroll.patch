+ private:
+  void OnPrimaryPastePrefChanged() override {
+    const bool allowed = ui::Clipboard::IsMiddleClickPasteEnabled();
+    auto* prefs = web_contents_->GetMutableRendererPrefs();
+    if (prefs->middle_click_paste_allowed != allowed) {
+      prefs->middle_click_paste_allowed = allowed;
+      web_contents_->SyncRendererPrefs();
+    }
+  }
+
+  const raw_ref<WebContents> web_contents_;
+  base::ScopedObservation<ui::LinuxUi, ui::PrimaryPastePrefObserver>
+      observation_{this};
+};

+bool IsMiddleClickAutoscrollEnabled(const base::CommandLine& command_line) {
+  const auto& feature = blink::features::kMiddleClickAutoscroll;
+  // Match the renderer: explicit Blink switches take precedence over the base
+  // feature, which in turn can override the Blink test-feature default.
+  if (std::ranges::contains(
+          FeaturesFromSwitch(command_line, switches::kDisableBlinkFeatures),
+          feature.name)) {
+    return false;
+  }
+  if (std::ranges::contains(
+          FeaturesFromSwitch(command_line, switches::kEnableBlinkFeatures),
+          feature.name)) {
+    return true;
+  }
+  return base::FeatureList::IsEnabled(feature) ||
+         (command_line.HasSwitch(switches::kEnableBlinkTestFeatures) &&
+          !base::FeatureList::GetStateIfOverridden(feature).has_value());
+}
+#endif  // BUILDFLAG(IS_LINUX)

diff --git a/BUILD.gn b/BUILD.gn
index 0b93e144a76..9b96e949c04 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -346,7 +346,14 @@ declare_args() {
   # ARM64. Enable it by default for simulator builds and when native code
   # supports it as well. On Mac, control-flow integrity does not work so we
   # avoid enabling it when using the simulator.
+  #
+  # A Linux x64 mksnapshot targeting Windows ARM64 must match the Windows
+  # runtime, where arm_control_flow_integrity defaults to "none". Enabling
+  # simulator-only pointer authentication would produce an incompatible
+  # startup snapshot.
   v8_control_flow_integrity = v8_current_cpu == "arm64" &&
+                              !(host_os == "linux" && host_cpu == "x64" &&
+                                target_os == "win" && target_cpu == "arm64") &&
                               ((v8_target_is_simulator && target_os != "mac") ||
                                arm_control_flow_integrity != "none")
 
diff --git a/gni/snapshot_toolchain.gni b/gni/snapshot_toolchain.gni
index 37ed262640d..f9973c0cd0b 100644
--- a/gni/snapshot_toolchain.gni
+++ b/gni/snapshot_toolchain.gni
@@ -46,7 +46,14 @@ declare_args() {
 # https://crbug.com/625353.
 
 if (v8_snapshot_toolchain == "") {
-  if (current_os == host_os && current_cpu == host_cpu) {
+  if (host_os == "linux" && host_cpu == "x64" && current_os == "win" &&
+      v8_current_cpu == "arm64") {
+    # Generate the Windows ARM64 snapshot with V8's ARM64 simulator. The
+    # generic host toolchain produces a host-configured snapshot that is not
+    # compatible with the native Windows ARM64 runtime.
+    v8_snapshot_toolchain =
+        "//build/toolchain/linux:clang_x64_v8_arm64"
+  } else if (current_os == host_os && current_cpu == host_cpu) {
     # This is not a cross-compile, so build the snapshot with the current
     # toolchain.
     v8_snapshot_toolchain = current_toolchain
